# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# Mercado Pago
# https://www.mercadopago.com.mx/developers/panel
# ============================================================
MP_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-...
# Secreto de firma de webhooks (Tus integraciones -> Notificaciones webhook)
MP_WEBHOOK_SECRET=...

# ============================================================
# Billpocket (Flex / Basic Gateway) — pasarela alterna a Mercado Pago
# Dashboard → Configuración → Integraciones
# ============================================================
BILLPOCKET_API_KEY=...
# Demo: https://lancehorn.billpocket.dev/scops · Prod (default si se omite): https://lancehorn.billpocket.com/scops
BILLPOCKET_BASE_URL=https://lancehorn.billpocket.dev/scops

# Secreto para proteger /api/billpocket/cron-mensualidad (Vercel lo manda solo
# como header Authorization si esta variable está configurada en el proyecto)
CRON_SECRET=...

# Campo "Token" del dashboard (Configuración → Integraciones → Webhook
# General). Verificación adicional al webhook, aparte de la firma RSA.
BILLPOCKET_WEBHOOK_TOKEN=...

# ============================================================
# App
# ============================================================
# URL pública del sitio (usada en back_urls / notification_url de Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
