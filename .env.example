# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# Mercado Pago
# https://www.mercadopago.com.mx/developers/panel
# ============================================================
MP_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-...
# Secreto de firma de webhooks (Tus integraciones -> Notificaciones webhook)
MP_WEBHOOK_SECRET=...

# ============================================================
# Billpocket — pago con tarjeta vía link hospedado (pay.billpocket.com/creerser)
# El pago queda "pendiente" y se confirma manualmente en /admin/pagos.
# ============================================================
# Campo "Token" del dashboard (Configuración → Integraciones → Webhook
# General), por si Billpocket llega a notificar el pago por webhook.
BILLPOCKET_WEBHOOK_TOKEN=...

# ============================================================
# App
# ============================================================
# URL pública del sitio (usada en back_urls / notification_url de Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
